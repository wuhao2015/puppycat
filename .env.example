# PostgreSQL
POSTGRES_USER=puppycat
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=puppycat

# Service URLs
API_INTERNAL_BASE_URL=http://localhost:8001
CORS_ALLOW_ORIGINS=http://localhost:3000

# Authentication
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SIGNUP_CODE=replace-with-a-private-invite-code

# External APIs (used in later phases)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.7-flash
GOOGLE_PLACES_API_KEY=
TAVILY_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
